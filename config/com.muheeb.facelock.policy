<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>FaceLock by Muheeb</vendor>
  <vendor_url>https://github.com/muheebbinnadeem/facelockbymuheeb</vendor_url>

  <action id="com.muheeb.facelock.manage">
    <description>Configure FaceLock PAM authentication and encrypted face profiles</description>
    <message>Authentication is required to update FaceLock system security settings</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/facelock/facelock-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
