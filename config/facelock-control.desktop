[Desktop Entry]
Version=1.0
Type=Application
Name=FaceLock (Kali Hello)
GenericName=Biometric & PAM Authentication Suite
Comment=Configure Face Lock, Fingerprint, System Password PAM hooks, and Encrypted Folder Vaults
Exec=/usr/local/bin/facelock-gui
Icon=security-high
Terminal=false
Categories=Settings;Security;System;GTK;
Keywords=face;fingerprint;hello;biometric;pam;sudo;lock;vault;kali;
StartupNotify=true
